<!--
  webcam.launch.xml
  DICT_7X7_50 Gate Centering - Webcam Pipeline

  Usage:
    ros2 launch fiducial_detector webcam.launch.xml
    ros2 launch fiducial_detector webcam.launch.xml device_id:=2
    ros2 launch fiducial_detector webcam.launch.xml device_path:=/dev/video6
    ros2 launch fiducial_detector webcam.launch.xml marker_size:=0.15
-->
<launch>
  <arg name="device_id"   default="0"     description="V4L2 device index"/>
  <arg name="device_path" default=""      description="Optional /dev/videoX (overrides device_id)"/>
  <arg name="width"       default="640"/>
  <arg name="height"      default="480"/>
  <arg name="fps_limit"   default="30.0"/>
  <arg name="marker_size" default="0.05"  description="Physical marker size in metres"/>
  <arg name="show_window" default="false"/>
  <arg name="npu"         default="true"  description="true/false - probe Raspberry Pi AI HAT / Hailo NPU"/>

  <!-- C++ Camera Capture Node (OpenCV VideoCapture via V4L2) -->
  <node pkg="fiducial_detector" exec="capture_node" name="capture_node" output="screen">
    <param name="source"       value="webcam"/>
    <param name="device_id"    value="$(var device_id)"/>
    <param name="device_path"  value="$(var device_path)"/>
    <param name="width"        value="$(var width)"/>
    <param name="height"       value="$(var height)"/>
    <param name="fps_limit"    value="$(var fps_limit)"/>
    <param name="output_topic" value="/camera/image_raw"/>
    <param name="frame_id"     value="camera_optical_frame"/>
  </node>

  <!-- DICT_7X7_50 Gate Centering Node -->
  <node pkg="fiducial_detector" exec="aruco_node" name="aruco_node" output="screen">
    <param from="$(find-pkg-share fiducial_detector)/config/detector.yaml"/>
    <param name="camera_topic" value="/camera/image_raw"/>
    <param name="marker_size"  value="$(var marker_size)"/>
    <param name="show_window"  value="$(var show_window)"/>
    <param name="npu"          value="$(var npu)"/>
  </node>
</launch>
