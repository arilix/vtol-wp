Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Image
      Enabled: true
      Name: GeneralBox Annotated Camera
      Normalize Range: true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /general_box/image_annotated
      Value: true
    - Class: rviz_default_plugins/TF
      Enabled: true
      Frame Timeout: 15
      Frames:
        All Enabled: true
      Marker Scale: 0.35
      Name: TF - YOLO BBox Target
      Show Arrows: true
      Show Axes: true
      Show Names: true
      Tree:
        camera_color_optical_frame:
          yolo_bbox_target:
            {}
      Update Interval: 0
      Value: true
    - Class: rviz_default_plugins/Axes
      Enabled: true
      Length: 0.25
      Name: YOLO BBox Axes
      Radius: 0.02
      Reference Frame: yolo_bbox_target
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: GeneralBox Markers
      Namespaces:
        general_box: true
        general_box_label: true
        general_box_pose: true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /general_box/markers
      Value: true
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: camera_color_optical_frame
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 10
      Name: Current View
Window Geometry:
  Height: 720
  Width: 1100
