<launch>
  <arg name="altitude_command_bias_m" default="0.0"/>
  <arg name="use_lidar_altitude" default="true"/>
  <arg name="start_tfmini_lidar" default="true"/>
  <!-- start_mode:
       - takeoff: mode lama, program arm/offboard lalu naik dari bawah.
       - airborne_handoff: drone sudah hover dari RC, program ambil alih,
         tahan N/E/yaw, sejajarkan altitude lidar, lalu lanjut ArUco/misi.
       - gate_pass: setelah takeoff+hover, BYPASS TOTAL ArUco/YOLO/gripper,
         langsung runGatePassMission() (Livox MID360s). Wajib pasang
         gate_centering_enable:=true juga — lihat
         docs/LIVOX_MID360_INTEGRATION.md §9. -->
  <arg name="start_mode" default="takeoff"/>
  <arg name="start_mission_after_hover" default="false"/>
  <arg name="override_mission_heading" default="false"/>
  <arg name="mission_heading_deg" default="0.0"/>
  <arg name="mission_heading_correction_deg" default="0.0"/>
  <arg name="marker_heading_align_enable" default="true"/>
  <arg name="marker_heading_back_id" default="0"/>
  <arg name="marker_heading_front_id" default="1"/>
  <arg name="marker_heading_tolerance_deg" default="5.0"/>
  <arg name="marker_heading_timeout_s" default="8.0"/>
  <arg name="marker_heading_yaw_sign" default="1.0"/>

  <!-- TF Mini I2C lidar. Node ini publish sensor_msgs/Range ke /range,
       topic yang dibaca mission manager untuk altitude lidar. -->
  <arg name="tfmini_bus_device" default="/dev/i2c-1"/>
  <arg name="tfmini_i2c_address" default="16"/>
  <arg name="tfmini_i2c_read_mode" default="command"/>
  <arg name="tfmini_frame_id" default="tfmini_link"/>
  <arg name="tfmini_publish_rate" default="20.0"/>
  <arg name="tfmini_min_range" default="0.03"/>
  <arg name="tfmini_max_range" default="12.0"/>
  <arg name="tfmini_field_of_view" default="0.04"/>
  <arg name="tfmini_range_offset" default="0.0"/>
  <arg name="tfmini_log_rate" default="1.0"/>
  <arg name="tfmini_mavlink_enabled" default="false"/>
  <arg name="tfmini_mavlink_device" default="/dev/ttyAMA0"/>
  <arg name="tfmini_mavlink_system_id" default="1"/>
  <arg name="tfmini_mavlink_component_id" default="191"/>
  <arg name="tfmini_mavlink_sensor_id" default="0"/>
  <arg name="tfmini_mavlink_orientation" default="25"/>
  <arg name="tfmini_mavlink_covariance" default="0"/>

  <!-- Vision lock (koreksi posisi via marker ArUco kamera nadir) —
       lihat PROGRAM_OVERVIEW.md. camera_mount_yaw_deg WAJIB dikalibrasi
       di lapangan sebelum dipercaya. vision_lock_enable:=false adalah
       kill-switch instan kalau vision lock bermasalah di lapangan. -->
  <arg name="vision_lock_enable" default="true"/>
  <arg name="camera_mount_yaw_deg" default="0.0"/>
  <arg name="vision_max_correction_m" default="0.4"/>
  <arg name="marker_center_tolerance_m" default="0.10"/>
  <arg name="marker_search_timeout_s" default="20.0"/>

  <!-- Ground lock (koreksi posisi via box YOLO, khusus WP1) — lihat
       PROGRAM_OVERVIEW.md. Kamera fisik sama dengan ArUco (mount yaw
       dari camera_mount_yaw_deg di atas dipakai juga di sini), jadi
       cukup kalibrasi fokal (fx/fy piksel) kalau berbeda dari default
       placeholder fiducial_detector. ground_lock_enable:=false adalah
       kill-switch instan khusus jalur YOLO WP1. -->
  <arg name="ground_lock_enable" default="true"/>
  <arg name="yolo_camera_fx_px" default="640.0"/>
  <arg name="yolo_camera_fy_px" default="640.0"/>

  <arg name="gripper_drop_enable" default="true"/>
  <arg name="gripper_cmd_topic" default="/gripper_cmd"/>
  <arg name="gripper_open_wait_ticks" default="15"/>
  <arg name="gripper_close_wait_ticks" default="15"/>

  <!-- Gate centering (Livox MID360s, /livox/points) — lihat
       docs/LIVOX_MID360_INTEGRATION.md. Kill-switch lapangan, default
       FALSE dan subscriber point cloud tidak dibuat sama sekali. Saat true,
       start_mode gate_pass menjalankan test gate standalone; pada misi
       takeoff/handoff fitur menjadi gate assist opt-in di setiap leg maju.
       Params gate_centering.* ada di config YAML. -->
  <arg name="gate_centering_enable" default="false"/>
  <arg name="start_livox_lidar" default="false"/>
  <arg name="livox_user_config_path" default="$(find-pkg-share livox_ros_driver2)/config/MID360_config.json"/>
  <arg name="livox_publish_freq" default="10.0"/>
  <arg name="livox_frame_id" default="livox_frame"/>

  <!--
    Launch mission_manager_node.

    Pastikan sebelum ini sudah jalan:
      - PX4 SITL (atau flight controller fisik)
      - MicroXRCEAgent (jembatan PX4 <-> ROS2)
      - pose_republisher (jika pakai FastLIO sebagai sumber posisi)
      - aruco_node + yolo_camera_node (opsional, kalau vision/ground lock
        dipakai) — lihat fiducial_detector/launch/webcam_with_yolo.launch.xml
        dan LAUNCH_TUTORIAL.md untuk cara jalankan.
  -->
  <node pkg="tfmini_i2c_ros" exec="tfmini_i2c_node" name="tfmini_i2c_node" output="screen" if="$(var start_tfmini_lidar)">
    <param name="bus_device" value="$(var tfmini_bus_device)"/>
    <param name="i2c_address" value="$(var tfmini_i2c_address)"/>
    <param name="i2c_read_mode" value="$(var tfmini_i2c_read_mode)"/>
    <param name="frame_id" value="$(var tfmini_frame_id)"/>
    <param name="publish_rate" value="$(var tfmini_publish_rate)"/>
    <param name="min_range" value="$(var tfmini_min_range)"/>
    <param name="max_range" value="$(var tfmini_max_range)"/>
    <param name="field_of_view" value="$(var tfmini_field_of_view)"/>
    <param name="range_offset" value="$(var tfmini_range_offset)"/>
    <param name="log_rate" value="$(var tfmini_log_rate)"/>
    <param name="mavlink_enabled" value="$(var tfmini_mavlink_enabled)"/>
    <param name="mavlink_device" value="$(var tfmini_mavlink_device)"/>
    <param name="mavlink_system_id" value="$(var tfmini_mavlink_system_id)"/>
    <param name="mavlink_component_id" value="$(var tfmini_mavlink_component_id)"/>
    <param name="mavlink_sensor_id" value="$(var tfmini_mavlink_sensor_id)"/>
    <param name="mavlink_orientation" value="$(var tfmini_mavlink_orientation)"/>
    <param name="mavlink_covariance" value="$(var tfmini_mavlink_covariance)"/>
  </node>

  <node pkg="px4" exec="px4" name="mission_manager" output="screen">
    <param name="altitude_command_bias_m" value="$(var altitude_command_bias_m)"/>
    <param name="use_lidar_altitude" value="$(var use_lidar_altitude)"/>
    <param name="start_mode" value="$(var start_mode)"/>
    <param name="start_mission_after_hover" value="$(var start_mission_after_hover)"/>
    <param name="override_mission_heading" value="$(var override_mission_heading)"/>
    <param name="mission_heading_deg" value="$(var mission_heading_deg)"/>
    <param name="mission_heading_correction_deg" value="$(var mission_heading_correction_deg)"/>
    <param name="marker_heading_align_enable" value="$(var marker_heading_align_enable)"/>
    <param name="marker_heading_back_id" value="$(var marker_heading_back_id)"/>
    <param name="marker_heading_front_id" value="$(var marker_heading_front_id)"/>
    <param name="marker_heading_tolerance_deg" value="$(var marker_heading_tolerance_deg)"/>
    <param name="marker_heading_timeout_s" value="$(var marker_heading_timeout_s)"/>
    <param name="marker_heading_yaw_sign" value="$(var marker_heading_yaw_sign)"/>
    <param name="vision_lock_enable" value="$(var vision_lock_enable)"/>
    <param name="camera_mount_yaw_deg" value="$(var camera_mount_yaw_deg)"/>
    <param name="vision_max_correction_m" value="$(var vision_max_correction_m)"/>
    <param name="marker_center_tolerance_m" value="$(var marker_center_tolerance_m)"/>
    <param name="marker_search_timeout_s" value="$(var marker_search_timeout_s)"/>
    <param name="ground_lock_enable" value="$(var ground_lock_enable)"/>
    <param name="yolo_camera_fx_px" value="$(var yolo_camera_fx_px)"/>
    <param name="yolo_camera_fy_px" value="$(var yolo_camera_fy_px)"/>
    <param name="gripper_drop_enable" value="$(var gripper_drop_enable)"/>
    <param name="gripper_cmd_topic" value="$(var gripper_cmd_topic)"/>
    <param name="gripper_open_wait_ticks" value="$(var gripper_open_wait_ticks)"/>
    <param name="gripper_close_wait_ticks" value="$(var gripper_close_wait_ticks)"/>
    <param name="gate_centering_enable" value="$(var gate_centering_enable)"/>
    <param from="$(find-pkg-share px4)/config/gate_centering.yaml"/>
  </node>

  <!-- Livox MID360s driver — publish PointCloud2 di /livox/points (xfer_format=0).
       Lihat docs/LIVOX_MID360_INTEGRATION.md untuk setup IP host/lidar
       (config/gate_centering.yaml punya param gate_centering.*, IP jaringan
       ada di livox_ros_driver2/config/MID360_config.json). -->
  <node pkg="livox_ros_driver2" exec="livox_ros_driver2_node" name="livox_lidar_publisher" output="screen" if="$(var start_livox_lidar)">
    <param name="xfer_format" value="0"/>
    <param name="multi_topic" value="0"/>
    <param name="data_src" value="0"/>
    <param name="publish_freq" value="$(var livox_publish_freq)"/>
    <param name="output_data_type" value="0"/>
    <param name="frame_id" value="$(var livox_frame_id)"/>
    <param name="user_config_path" value="$(var livox_user_config_path)"/>
    <param name="cmdline_input_bd_code" value="livox0000000001"/>
    <remap from="livox/lidar" to="/livox/points"/>
    <remap from="livox/imu" to="/livox/imu"/>
  </node>
</launch>
