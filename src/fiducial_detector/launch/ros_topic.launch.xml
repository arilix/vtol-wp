<!--
  ros_topic.launch.xml
  DICT_7X7_50 Gate Centering - subscribe ke existing ROS 2 image topic.
  Tidak menjalankan camera node - cocok jika image_raw sudah dipublish node lain.

  Usage:
    ros2 launch fiducial_detector ros_topic.launch.xml
    ros2 launch fiducial_detector ros_topic.launch.xml camera_topic:=/my_cam/image_raw
    ros2 launch fiducial_detector ros_topic.launch.xml marker_size:=0.15
-->
<launch>
  <arg name="camera_topic" default="/camera/image_raw"  description="Existing ROS image topic"/>
  <arg name="marker_size"  default="0.05"               description="Physical marker size in metres"/>
  <arg name="show_window"  default="false"/>
  <arg name="npu"          default="true"                description="true/false - probe Raspberry Pi AI HAT / Hailo NPU"/>

  <!-- DICT_7X7_50 Gate Centering Node -->
  <node pkg="fiducial_detector" exec="aruco_node" name="aruco_node" output="screen">
    <param from="$(find-pkg-share fiducial_detector)/config/detector.yaml"/>
    <param name="camera_topic" value="$(var camera_topic)"/>
    <param name="marker_size"  value="$(var marker_size)"/>
    <param name="show_window"  value="$(var show_window)"/>
    <param name="npu"          value="$(var npu)"/>
  </node>
</launch>
