<!--
  calibration.launch.xml
  Kalibrasi intrinsik kamera menggunakan chessboard (CHESSBOARD mode).

  Cara pakai:
    1. Siapkan chessboard 9x6 (cetak atau layar)
    2. Launch node ini sambil kamera aktif
    3. SPACE  -> capture frame (minimal 15 frame dari berbagai sudut)
    4. 'c'    -> hitung kalibrasi
    5. 's'    -> simpan ke YAML
    6. 'q'/ESC -> keluar

  Usage:
    ros2 launch fiducial_detector calibration.launch.xml
    ros2 launch fiducial_detector calibration.launch.xml camera_topic:=/my_cam/image_raw
    ros2 launch fiducial_detector calibration.launch.xml output_yaml:=/home/user/calib.yaml
    ros2 launch fiducial_detector calibration.launch.xml chess_cols:=9 chess_rows:=6
-->
<launch>
  <arg name="camera_topic"  default="/camera/image_raw"           description="Image source topic"/>
  <arg name="output_yaml"   default="/tmp/camera_calibration.yaml" description="Output YAML path"/>
  <arg name="calib_mode"    default="CHESSBOARD"                   description="CHESSBOARD (CHARUCO deprecated)"/>
  <arg name="chess_cols"    default="9"                            description="Chessboard inner corners - columns"/>
  <arg name="chess_rows"    default="6"                            description="Chessboard inner corners - rows"/>
  <arg name="chess_square"  default="0.025"                        description="Square size in metres"/>
  <arg name="min_frames"    default="15"                           description="Minimum frames before calibration valid"/>
  <arg name="show_window"   default="true"/>

  <node pkg="fiducial_detector" exec="calibration_node" name="calibration_node" output="screen">
    <param name="camera_topic" value="$(var camera_topic)"/>
    <param name="output_yaml"  value="$(var output_yaml)"/>
    <param name="calib_mode"   value="$(var calib_mode)"/>
    <param name="chess_cols"   value="$(var chess_cols)"/>
    <param name="chess_rows"   value="$(var chess_rows)"/>
    <param name="chess_square" value="$(var chess_square)"/>
    <param name="min_frames"   value="$(var min_frames)"/>
    <param name="show_window"  value="$(var show_window)"/>
  </node>
</launch>
