<!--
  realsense.launch.xml - Intel RealSense + DICT_7X7_50 Gate Centering

  Usage:
    ros2 launch fiducial_detector realsense.launch.xml
    ros2 launch fiducial_detector realsense.launch.xml marker_size:=0.15
    ros2 launch fiducial_detector realsense.launch.xml width:=640 height:=480 fps_limit:=30
-->
<launch>
  <arg name="width"       default="640"/>
  <arg name="height"      default="480"/>
  <arg name="fps_limit"   default="15"   description="Camera FPS (integer)"/>
  <arg name="marker_size" default="0.05" description="Physical marker size in metres"/>
  <arg name="min_detection_confidence" default="0.50" description="Minimum accepted detector confidence"/>
  <arg name="show_window" default="false"/>
  <arg name="publish_debug_image" default="false" description="Publish /fiducial/debug_image"/>
  <arg name="show_compass" default="true" description="Draw IMU-integrated compass on /fiducial/debug_image"/>
  <arg name="imu_topic" default="/camera/camera/imu" description="RealSense unified IMU topic"/>
  <arg name="compass_heading_offset_deg" default="0.0" description="Heading offset added to integrated gyro compass"/>
  <arg name="pose_yaw_offset_deg" default="180.0" description="Rotate ArUco pose axes for the inverted camera mount"/>
  <arg name="npu"         default="true"  description="true/false - probe Raspberry Pi AI HAT / Hailo NPU"/>
  <arg name="color_format" default="YUYV" description="RealSense color format"/>
  <arg name="drone_ned_frame" default="base_link_ned" description="Drone body frame in NED/FRD convention"/>
  <arg name="camera_base_frame" default="camera_link" description="RealSense base frame published by realsense2_camera"/>
  <arg name="camera_x_ned" default="0.0" description="Camera offset from drone origin, +X forward, metres"/>
  <arg name="camera_y_ned" default="0.0" description="Camera offset from drone origin, +Y right, metres"/>
  <arg name="camera_z_ned" default="0.0" description="Camera offset from drone origin, +Z down, metres"/>

  <!-- Mount transform: camera faces down, top of camera points forward.
       NED/FRD -> camera_link quaternion xyzw = (0.7071068, 0, 0.7071068, 0). -->
  <node pkg="tf2_ros" exec="static_transform_publisher" name="camera_ned_mount_tf"
        args="--x $(var camera_x_ned) --y $(var camera_y_ned) --z $(var camera_z_ned) --qx 0.7071068 --qy 0.0 --qz 0.7071068 --qw 0.0 --frame-id $(var drone_ned_frame) --child-frame-id $(var camera_base_frame)"
        output="screen"/>

  <!-- Intel RealSense ROS2 driver - publishes /camera/camera/color/image_raw -->
  <node pkg="realsense2_camera" exec="realsense2_camera_node"
        namespace="camera" output="screen">
    <param name="camera_name"              value="camera"/>
    <param name="enable_color"             value="true"/>
    <param name="enable_depth"             value="false"/>
    <param name="enable_infra"             value="false"/>
    <param name="enable_infra1"            value="false"/>
    <param name="enable_infra2"            value="false"/>
    <param name="enable_gyro"              value="true"/>
    <param name="enable_accel"             value="true"/>
    <param name="unite_imu_method"         value="2"/>
    <param name="rgb_camera.color_profile" value="$(var width),$(var height),$(var fps_limit)"/>
    <param name="rgb_camera.color_format"  value="$(var color_format)"/>
  </node>

  <!-- DICT_7X7_50 Gate Centering Node -->
  <node pkg="fiducial_detector" exec="aruco_node" name="aruco_node" output="screen">
    <param from="$(find-pkg-share fiducial_detector)/config/detector.yaml"/>
    <param name="camera_topic" value="/camera/camera/color/image_raw"/>
    <param name="marker_size"  value="$(var marker_size)"/>
    <param name="min_detection_confidence" value="$(var min_detection_confidence)"/>
    <param name="show_window"  value="$(var show_window)"/>
    <param name="publish_debug_image" value="$(var publish_debug_image)"/>
    <param name="show_compass" value="$(var show_compass)"/>
    <param name="imu_topic" value="$(var imu_topic)"/>
    <param name="compass_heading_offset_deg" value="$(var compass_heading_offset_deg)"/>
    <param name="pose_yaw_offset_deg" value="$(var pose_yaw_offset_deg)"/>
    <param name="output_frame_id" value="camera_link"/>
    <param name="npu"          value="$(var npu)"/>
  </node>
</launch>
